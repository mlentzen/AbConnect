FROM docker.io/library/python:3.12-slim

# ffmpeg schneidet, curl bedient den Healthcheck des Quadlets.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg curl \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml ./
COPY abconnect_proxy ./abconnect_proxy
RUN pip install --no-cache-dir .

# Rootless-freundlich: die Volumes gehören dem Dienstnutzer, nicht root.
RUN useradd --system --uid 10001 --create-home abconnect \
 && mkdir -p /var/cache/abconnect /var/tmp/abconnect \
 && chown -R abconnect:abconnect /var/cache/abconnect /var/tmp/abconnect
USER abconnect

EXPOSE 8080
HEALTHCHECK --interval=60s --timeout=10s --start-period=20s \
    CMD curl -fsS http://localhost:8080/healthz || exit 1

CMD ["python", "-m", "abconnect_proxy"]
