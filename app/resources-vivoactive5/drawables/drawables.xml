<drawables>
    <!-- The vivoactive 5 wants a 56 px launcher icon: 140 % of the 40 x 40 that
         ab.svg and menu_glyph.svg declare. Otherwise as in
         resources/drawables/drawables.xml. -->
    <bitmap id="LauncherIcon" filename="../../resources/drawables/ab.svg" dithering="none" scaleX="140%" scaleY="140%" scaleRelativeTo="image"/>
    <bitmap id="ProviderIcon" filename="../../resources/drawables/menu_glyph.svg" dithering="none" scaleX="140%" scaleY="140%" scaleRelativeTo="image">
        <palette>
            <color>AAAAAA</color>
        </palette>
    </bitmap>
    <!-- Its menu rows have a 65 px icon slot: 160 % of 40 = 64 px. -->
    <bitmap id="IconContinue" filename="../../resources/drawables/icon_play.svg" dithering="none" scaleX="160%" scaleY="160%" scaleRelativeTo="image"/>
    <bitmap id="IconBooks" filename="../../resources/drawables/icon_books.svg" dithering="none" scaleX="160%" scaleY="160%" scaleRelativeTo="image"/>
    <bitmap id="IconSync" filename="../../resources/drawables/icon_sync.svg" dithering="none" scaleX="160%" scaleY="160%" scaleRelativeTo="image"/>
    <bitmap id="IconReset" filename="../../resources/drawables/icon_reset.svg" dithering="none" scaleX="160%" scaleY="160%" scaleRelativeTo="image"/>
    <bitmap id="IconInfo" filename="../../resources/drawables/icon_info.svg" dithering="none" scaleX="160%" scaleY="160%" scaleRelativeTo="image"/>
</drawables>
