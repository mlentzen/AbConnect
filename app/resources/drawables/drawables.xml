<drawables>
    <!-- 40x40: launcher size of the fēnix 7 family and other MIP peers.
         Devices that need a different size override this via monkey.jungle
         resource overlays (resources-54x54, …). -->
    <bitmap id="LauncherIcon" filename="ab.svg" dithering="none"/>
    <!-- For getProviderIconInfo(): the watch shows it on the entry that opens
         this app's menu, among the system's own entries, so it is a plain menu
         symbol in their style rather than the artwork. -->
    <bitmap id="ProviderIcon" filename="menu_glyph.svg" dithering="none">
        <palette>
            <color>AAAAAA</color>
        </palette>
    </bitmap>
    <!-- Row icons of the app menu, on the same 40 x 40 grid and in the same
         grey as the system's own menu icons. -->
    <bitmap id="IconContinue" filename="icon_play.svg" dithering="none"/>
    <bitmap id="IconBooks" filename="icon_books.svg" dithering="none"/>
    <bitmap id="IconSync" filename="icon_sync.svg" dithering="none"/>
    <bitmap id="IconReset" filename="icon_reset.svg" dithering="none"/>
    <bitmap id="IconInfo" filename="icon_info.svg" dithering="none"/>
    <bitmap id="IconSettings" filename="icon_settings.svg" dithering="none"/>
</drawables>
