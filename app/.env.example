# Copy to .env (git-ignored). Read by build.sh and copy.sh.

# Optional. Baked into the .prg when set; otherwise the build uses
# https://abconnect.example.com and replace-me, and the real values are
# entered in the app settings. A .prg built with a real token contains it.
# Do not share that .prg.
#PROXY_URL=https://abconnect.example.com
#PROXY_TOKEN=replace-me

# Log level of the build: 0 errors (default), 1 warnings, 2 course of events, 3 everything
#LOG_LEVEL=0

# Connect IQ SDK directory (contains bin/monkeyc). build.sh defaults to /opt/ciq.
#CIQ_HOME=/path/to/connectiq-sdk
# Developer key, PKCS8 DER. Default: ~/.ciq/developer_key
#CIQ_KEY=$HOME/.ciq/developer_key
# Device id passed to the compiler. Default: fenix7xpro
#DEVICE=fenix7xpro

# copy.sh only: gio URI of the watch while plugged in (list with `gio mount -l`)
#WATCH_MTP=mtp://<vendor>_<product>_<serial>
