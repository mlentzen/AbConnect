# Podman-Quadlet: baut das Proxy-Image direkt aus dem Arbeitsbaum.
#
# SetWorkingDirectory macht proxy/ zum Build-Kontext, damit die COPY-Zeilen
# des Containerfiles greifen. Der Pfad ist maschinenabhängig — deploy/install.sh
# trägt beim Installieren den tatsächlichen Ort des Checkouts ein.

[Unit]
Description=Build des AbConnect-Proxy-Images

[Build]
ImageTag=localhost/abconnect-proxy:latest
File=Containerfile
SetWorkingDirectory=%h/git/AbConnect/proxy

# Holt auch ein neueres python:3.12-slim, nicht nur geänderten eigenen Code.
Pull=newer

[Install]
WantedBy=default.target
