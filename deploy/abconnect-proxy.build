# Podman quadlet: builds the proxy image directly from the working tree.
#
# SetWorkingDirectory makes proxy/ the build context so the Containerfile's COPY
# lines resolve. The path is machine-dependent — deploy/install.sh fills in the
# actual location of the checkout during installation.

[Unit]
Description=Build of the AbConnect proxy image

[Build]
ImageTag=localhost/abconnect-proxy:latest
File=Containerfile
SetWorkingDirectory=%h/git/AbConnect/proxy

# Also pulls a newer python:3.12-slim, not just changed local code.
Pull=newer

[Install]
WantedBy=default.target
