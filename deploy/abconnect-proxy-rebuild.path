# Not a quadlet but a plain user unit: goes into ~/.config/systemd/user/.
#
# Watches the branch tip, not the source files: a rebuild runs after a commit,
# `git pull` or checkout — not mid-typing. Branch and path are filled in by
# deploy/install.sh during installation; after a merge to main one line here
# needs changing (or run install.sh again).
#
# Caution: `git gc` or `git pack-refs` can remove the ref file. systemd then
# watches the next existing directory up and triggers again as soon as the file
# reappears — but a commit right after packing can slip through. Then
# `systemctl --user start abconnect-proxy-rebuild` helps.

[Unit]
Description=Watch the AbConnect branch for new commits

[Path]
PathChanged=%h/git/AbConnect/.git/refs/heads/claude/audiobookshelf-connectiq-garmin-uh247o
Unit=abconnect-proxy-rebuild.service

[Install]
WantedBy=default.target
