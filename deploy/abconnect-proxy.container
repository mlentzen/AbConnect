# Podman quadlet: goes into ~/.config/containers/systemd/ — easiest via
# deploy/install.sh.
#
# The image contains neither a server address nor a key — users, their ABS
# instances and keys come from the abconnect-users secret (see deploy/README.md).
# If it is missing or invalid, the container does not start.

[Unit]
Description=AbConnect proxy (Audiobookshelf -> Garmin)
After=audiobookshelf.service
Wants=audiobookshelf.service

# The image is produced from abconnect-proxy.build; no manual build needed.
# Requires also means: a failed build (broken commit) takes the running
# container down with it. If you would rather keep the old image running,
# replace Requires with Wants.
Requires=abconnect-proxy-build.service
After=abconnect-proxy-build.service

[Container]
Image=abconnect-proxy.build
ContainerName=abconnect-proxy

Secret=abconnect-users,type=mount,target=/run/secrets/users.toml,uid=10001,mode=0400

# Disk space is available: a generous budget so released books stay around and
# re-selecting one does not require a second download.
Environment=CACHE_MAX_BYTES=214748364800
Environment=RELEASE_TTL_DAYS=30
Environment=LOG_LEVEL=INFO

Volume=abconnect-cache:/var/cache/abconnect
Volume=abconnect-work:/var/tmp/abconnect

PublishPort=127.0.0.1:18543:8080
HealthCmd=/usr/bin/curl -fsS http://localhost:8080/health
HealthInterval=60s
HealthStartPeriod=20s

[Service]
Restart=always

[Install]
WantedBy=default.target
