# Not a quadlet but a plain user unit: goes into ~/.config/systemd/user/.
#
# Both units in one call: systemd groups this into a single transaction and
# orders it via the container's After=, so it is built exactly once and then
# restarted. Naming the build service explicitly is intentional — whether a
# restart of the container pulls it in on its own depends on whether Quadlet
# creates it with RemainAfterExit, and that is an implementation detail of the
# respective Podman version.

[Unit]
Description=Rebuild and restart the AbConnect proxy

[Service]
Type=oneshot
ExecStart=/usr/bin/systemctl --user restart abconnect-proxy-build.service abconnect-proxy.service
